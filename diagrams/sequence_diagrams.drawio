        <mxCell id="p16" value="16. getToleransi(jadwal_id)" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#0f172a;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="430" y="580" as="sourcePoint"/><mxPoint x="600" y="580" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p17" value="17. Return: toleransi_menit, jam_mulai" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#64748b;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="610" as="sourcePoint"/><mxPoint x="430" y="610" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="alt_calc" value="alt [Kalkulasi Status Kehadiran berdasarkan selisih menit]" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1e293b;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="630" width="370" height="80" as="geometry" /></mxCell>
        <mxCell id="calc_text" value="selisih &amp;le; toleransi_menit &amp;rarr; Status = HADIR &#10003;&#xa;toleransi_menit &lt; selisih &amp;le; 2x toleransi &amp;rarr; Status = TERLAMBAT &#9888;&#xa;selisih &gt; 2x toleransi &amp;rarr; Status = ALPHA &#10007;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1"><mxGeometry x="330" y="650" width="350" height="50" as="geometry" /></mxCell>

        <mxCell id="p18" value="18. insert(presensi_id, mahasiswa_id, status, jam)" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#0f172a;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="430" y="730" as="sourcePoint"/><mxPoint x="970" y="730" as="targetPoint"/></mxGeometry></mxCell>
