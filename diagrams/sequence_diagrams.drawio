        <mxCell id="p20" value="20. NIM mahasiswa" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#64748b;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1295" y="770" as="sourcePoint"/><mxPoint x="970" y="770" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p21" value="21. generateHash(nim, kode_mk, tanggal, status)" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#0f172a;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="970" y="785" as="sourcePoint"/><mxPoint x="1130" y="785" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p22" value="22. SHA-256 hash string" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#64748b;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="800" as="sourcePoint"/><mxPoint x="970" y="800" as="targetPoint"/></mxGeometry></mxCell>
