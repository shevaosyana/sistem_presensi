  <!-- SD-05: Verifikasi Integritas Hash SHA-256 (Admin) -->
  <diagram id="SD-05" name="SD-05: Verifikasi Integritas SHA-256">
    <mxGraphModel dx="1300" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="850" math="0" shadow="0">
